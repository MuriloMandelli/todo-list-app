# Banco de dados PostgreSQL (Neon)
# DATABASE_URL: connection string COM pooler (host contém "-pooler"), usada pela app.
# DIRECT_URL:   connection string SEM pooler, usada pelo Prisma nas migrations.
# Pegue as duas em https://console.neon.tech (Connection Details).

DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"
